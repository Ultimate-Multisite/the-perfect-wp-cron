{
  "name": "the-perfect-wp-cron",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "clean-css-cli": "^5.6",
    "uglify-js": "^3.17"
  },
  "scripts": {
    "css:build": "cleancss -o assets/admin.min.css assets/admin.css",
    "js:build": "uglifyjs assets/admin.js -c -m -o assets/admin.min.js",
    "build": "pnpm run css:build && pnpm run js:build",
    "archive": "bash scripts/archive.sh"
  }
}
